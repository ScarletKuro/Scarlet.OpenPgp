<Project>
  <PropertyGroup>
    <!-- Shared across the library and the CLI tool, and all of the tool's packages: the pointer
         package resolves its RID-specific packages at exactly its own version. -->
    <ScarletOpenPgpVersion>0.1.0</ScarletOpenPgpVersion>

    <!-- Strong naming: an assembly identity, not a security feature. A strong-named .NET Framework
         app can only reference strong-named assemblies, and the library targets netstandard2.0, so
         it is signed. The key is public on purpose (Microsoft's guidance for open-source
         libraries); changing it changes the assembly identity, which breaks consumers. Every
         project uses it, so the library can name its friend assemblies by their public key. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Scarlet.OpenPgp.snk</AssemblyOriginatorKeyFile>
    <!-- The key's public half, for InternalsVisibleTo (friend assemblies of a signed one are named by it). -->
    <ScarletOpenPgpPublicKey></ScarletOpenPgpPublicKey>
  </PropertyGroup>
</Project>
