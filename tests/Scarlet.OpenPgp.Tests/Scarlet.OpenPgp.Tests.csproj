<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- Publishing this project as Native AOT is itself a test: ILC's trim/AOT analysis runs over
         the library, CLI, and tests with every warning promoted to an error, so anything not
         AOT-friendly fails the publish. Native AOT compiles with ILC, not ILLink, so this is
         IlcTreatWarningsAsErrors (ILLinkTreatWarningsAsErrors has no effect here).
         TreatWarningsAsErrors additionally makes the Roslyn trim/AOT analyzers fail a plain build.
         TrimmerSingleWarn=false reports each warning individually instead of collapsing them into
         one per assembly. -->
    <PublishAot>true</PublishAot>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.aot" Version="4.0.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <!-- Test-only, per SPEC.md's explicit carve-out: fixture generation and cross-validation only.
         Never referenced by the shipped Scarlet.OpenPgp library. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Scarlet.OpenPgp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scarlet.OpenPgp\Scarlet.OpenPgp.csproj" />
    <ProjectReference Include="..\..\src\Scarlet.OpenPgp.Cli\Scarlet.OpenPgp.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestAssets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
