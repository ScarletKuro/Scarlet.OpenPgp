<Project Sdk="Microsoft.NET.Sdk">

  <!-- Coverage-guided fuzzing harness (SharpFuzz + libFuzzer). Not shipped and not AOT-published:
       SharpFuzz instruments the built Scarlet.OpenPgp.dll in place before libFuzzer drives it.
       See README.md in this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" Version="2.3.0" />
    <!-- The independent reference for the differential targets (Differential.cs); fuzz-only, like
         its use in the test project. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wycheproof's vectors: the differential targets' seeds and the fixed RSA key. -->
    <None Include="..\..\tests\Scarlet.OpenPgp.Tests\TestAssets\wycheproof\*.json" Link="Seeds\wycheproof\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scarlet.OpenPgp\Scarlet.OpenPgp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fixed counterpart inputs for each target: one RSA and one Ed25519 signer, both signatures. -->
    <None Include="..\..\tests\Scarlet.OpenPgp.Tests\TestAssets\gnupg-generated\v4-multi-signer\data.txt" Link="Seeds\data.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\tests\Scarlet.OpenPgp.Tests\TestAssets\gnupg-generated\v4-multi-signer\data.txt.sig" Link="Seeds\data.txt.sig" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\tests\Scarlet.OpenPgp.Tests\TestAssets\gnupg-generated\v4-multi-signer\keyring-both.gpg" Link="Seeds\keyring-both.gpg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every binary fixture keyring, so seeds from any fixture reach real signature verification
         instead of stopping at "no matching key". RecursiveDir keeps same-named files apart. -->
    <None Include="..\..\tests\Scarlet.OpenPgp.Tests\TestAssets\**\*.gpg" Link="Seeds\keys\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
