<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 remains the primary target for the widest possible consumer compatibility.
         net10.0 is added so the library can actually be AOT/trim-analyzed at all (netstandard2.0
         builds cannot be: https://learn.microsoft.com/dotnet/core/compatibility/sdk/8.0/trimming-unsupported-targetframework)
         and so Scarlet.OpenPgp.Cli's PublishAot build consumes a properly-annotated assembly. -->
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <!-- Test lane for the netstandard2.0 build: `dotnet test -p:ScarletOpenPgpLibraryTarget=netstandard2.0`
         builds only that target, so the (net10.0) tests and CLI run against it instead of the net10.0 one. -->
    <TargetFrameworks Condition="'$(ScarletOpenPgpLibraryTarget)' != ''">$(ScarletOpenPgpLibraryTarget)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- These rules suggest APIs that netstandard2.0 doesn't have (ArgumentNullException.ThrowIfNull,
         static HashData, Memory-based Stream.ReadAsync, string.StartsWith(char)/Contains(char), and
         StringComparison overloads of the already-ordinal Replace/IndexOf(char)), so the shared source
         can't follow them for both targets. Culture-sensitive comparisons (CA1309/CA1310) stay enforced. -->
    <NoWarn>$(NoWarn);CA1510;CA1850;CA1835;CA1865;CA2249;CA1307</NoWarn>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Scarlet.OpenPgp</RootNamespace>
    <!-- For fixed-size limb buffers in the curve field arithmetic (Crypto/Ed25519/FieldElement.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>

    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>

    <IsPackable>true</IsPackable>
    <PackageId>Scarlet.OpenPgp</PackageId>
    <Version>$(ScarletOpenPgpVersion)</Version>
    <Authors>ScarletKuro</Authors>
    <Description>Pure C#, zero-dependency, verify-only OpenPGP (RFC 9580 / RFC 4880) implementation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>openpgp;pgp;gpg;signature;verify;rfc9580;rfc4880</PackageTags>
    <!-- A .snupkg next to the package, so debuggers can step into the library (Source Link is on by default in the .NET 10 SDK). -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryUrl>https://github.com/ScarletKuro/Scarlet.OpenPgp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- On pack: both target frameworks must expose the same API. Once 1.0.0 is on NuGet, add
         <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion> so a breaking
         change to the public API fails the pack too. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- No third-party PackageReference items. The one exception is System.Memory below: it's a
       Microsoft-shipped BCL compatibility shim (not a third-party dependency in the sense the
       zero-dependency non-negotiable is guarding against) that brings Span<T>/ReadOnlySpan<T> to
       netstandard2.0. net10.0 already has these types natively and needs no such reference. -->

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <!-- PolySharp is a build-time source generator, not a runtime dependency: it compiles internal
       copies of the C# nullability attributes into the netstandard2.0 build (net10.0 already has
       them, so nothing is generated there). -->
  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!-- Build-time analyzer, not shipped: every public API change must be recorded in
       PublicAPI.Unshipped.txt, so it shows up in review. On a release, move its lines to
       PublicAPI.Shipped.txt.
       RS0026 (one optional parameter per overload set) is off: the Verify* overloads differ by
       required parameter types (string, bytes, key ring, stream) and each ends in the same
       optional verificationTime/cancellationToken, so calls are never ambiguous. A parameter
       added later goes into a new overload, not an extra optional one. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);RS0026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <PropertyGroup>
    <PolySharpIncludeGeneratedTypes>System.Diagnostics.CodeAnalysis.AllowNullAttribute;System.Diagnostics.CodeAnalysis.DisallowNullAttribute;System.Diagnostics.CodeAnalysis.DoesNotReturnAttribute;System.Diagnostics.CodeAnalysis.DoesNotReturnIfAttribute;System.Diagnostics.CodeAnalysis.MaybeNullAttribute;System.Diagnostics.CodeAnalysis.MaybeNullWhenAttribute;System.Diagnostics.CodeAnalysis.MemberNotNullAttribute;System.Diagnostics.CodeAnalysis.MemberNotNullWhenAttribute;System.Diagnostics.CodeAnalysis.NotNullAttribute;System.Diagnostics.CodeAnalysis.NotNullIfNotNullAttribute;System.Diagnostics.CodeAnalysis.NotNullWhenAttribute</PolySharpIncludeGeneratedTypes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scarlet.OpenPgp.Tests" />
    <InternalsVisibleTo Include="Scarlet.OpenPgp.Benchmarks" />
    <InternalsVisibleTo Include="Scarlet.OpenPgp.Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
  </ItemGroup>

</Project>
